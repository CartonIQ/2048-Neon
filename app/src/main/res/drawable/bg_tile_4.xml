<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#2C3442"
                android:startColor="#414958"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="30dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="11dp"
                android:topRightRadius="11dp" />
        </shape>
    </item>
</layer-list>
