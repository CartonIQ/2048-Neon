<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_dock_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_dock_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="34dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_sheen_end"
                android:startColor="@color/glass_sheen_start" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
        </shape>
    </item>
</layer-list>
