<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/how_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/how_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:shadowColor="@color/neon_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18"
            android:text="@string/how_title"
            android:textColor="@color/neon_cyan"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_goal_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_goal"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_move_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_move"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_merge_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_merge"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_tile_2"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/tile_text_light"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="+"
                    android:textColor="@color/text_secondary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_tile_2"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/tile_text_light"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="="
                    android:textColor="@color/text_secondary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_tile_4"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/tile_text_light"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_ladder_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_ladder"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_2"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/tile_text_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_4"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/tile_text_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_8"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/tile_text_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_16"
                    android:gravity="center"
                    android:text="16"
                    android:textColor="@color/tile_text_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_32"
                    android:gravity="center"
                    android:text="32"
                    android:textColor="@color/tile_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_64"
                    android:gravity="center"
                    android:text="64"
                    android:textColor="@color/tile_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_128"
                    android:gravity="center"
                    android:text="128"
                    android:textColor="@color/tile_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_256"
                    android:gravity="center"
                    android:text="256"
                    android:textColor="@color/tile_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_512"
                    android:gravity="center"
                    android:text="512"
                    android:textColor="@color/tile_text_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_1024"
                    android:gravity="center"
                    android:text="1024"
                    android:textColor="@color/tile_text_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                    <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_tile_2048"
                    android:gravity="center"
                    android:text="2048"
                    android:textColor="@color/tile_text_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                    
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_win_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_win_h"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_win_1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_win_2"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_win_3"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_win_4"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_over_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_over"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_help_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_help"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_score_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/how_tips_h"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/how_tips"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/how_got_it"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/how_got_it"
            android:textColor="@color/button_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/neon_cyan"
            app:cornerRadius="20dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
